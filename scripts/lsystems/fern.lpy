# Fern — L-Py L-system
# Built programmatically in the Axiom for full control.
# Parameters injected by generate.py via setCode.

from math import cos, sin, pi

module Frond

Axiom:
  d = 0.0
  for i in range(FROND_COUNT):
    angle = i * 2.0 * pi / FROND_COUNT + (SEED % 10) * 0.01
    spread = FROND_ANGLE
    nproduce ;(STEM_COLOR) F(HEIGHT * 0.6 / FROND_COUNT, STEM_RADIUS)
    nproduce [ /(angle * 180.0 / pi) &(spread * 90.0) ;(LEAF_COLOR) Frond(i, FROND_LENGTH, STEM_RADIUS) ]
  produce ;(STEM_COLOR) F(HEIGHT * 0.4, STEM_RADIUS * 0.7) @O(STEM_RADIUS * 2.0)

derivation length: 1
production:

Frond(i, length, radius):
  nproduce F(length, radius * 0.25)
  for j in range(LEAFLET_PAIRS):
    t = j / float(LEAFLET_PAIRS)
    ls = LEAFLET_SIZE * (1.0 - abs(t - 0.5) * 0.6)
    nproduce [ ;(LEAF_COLOR) &(20) f(t * length) ~l(ls) ]
    nproduce [ ;(LEAF_COLOR) -(20) f(t * length) ~l(ls) ]
  produce @O(radius * 0.2)

interpretation:

endlsystem
